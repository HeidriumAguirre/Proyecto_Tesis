# ================================================================
# Plantilla de variables de entorno para PRODUCCION (VPS)
# ================================================================
# INSTRUCCIONES:
#   1) cp .env.production.example .env
#   2) Editar .env y rellenar las 3 variables marcadas con CAMBIAR.
#   3) El archivo .env NUNCA se versiona (esta en .gitignore).
# ================================================================

# --- MySQL ---------------------------------------------------------------
# Generar password fuerte con: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=CAMBIAR_PASSWORD_MYSQL_AQUI
MYSQL_DATABASE=its_murialdo
# Puerto interno (no se publica al host, solo accesible desde Caddy)
MYSQL_PORT=3306

# --- Google Gemini -------------------------------------------------------
# Obtener en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=CAMBIAR_API_KEY_GEMINI_AQUI

# --- Streamlit -----------------------------------------------------------
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_PORT=8501
# Nivel de telemetría (false = no enviar datos a Streamlit)
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
